# ============================================================
#  EPUB 阅读器 — git 忽略规则
#  仓库根目录：C:\Users\yansuan\Desktop\书\
#
#  原则：只跟踪「手写的源文件」和「第三方库」。
#        凡是能用 build.bat / build_apk.bat 重新生成的，一律忽略。
# ============================================================


# ------------------------------------------------------------
#  一、构建产物（由 tools/build.py 生成，可随时重建）
# ------------------------------------------------------------
# dist/reader.html  —— src/ 拼成的单文件阅读器（可随时重建，忽略）
# 但 dist/ 里的 APK 是要随仓库发布的成品，单独放行
epubreader/dist/*
!epubreader/dist/epub-reader-1.0.apk

# web/reader.html   —— 上面那份的副本，供本地 HTTP 服务使用
# （web/lib/ 和 web/fonts/ 是源文件，不要一起忽略）
epubreader/web/reader.html


# ------------------------------------------------------------
#  二、APK 构建中间产物（由 android/tools/build_apk.py 生成）
# ------------------------------------------------------------
# javac 的 .class / d8 的 .dex / aapt2 的 gen
epubreader/android/build/

# 从 dist/reader.html 拷进去的入口页
epubreader/android/assets/index.html
# 从 web/fonts/ 拷进去的字体
epubreader/android/assets/fonts/

# 首次构建自动生成的调试签名证书
epubreader/android/debug.keystore


# ------------------------------------------------------------
#  三、验证 / 调试留下的临时文件（不属于项目）
# ------------------------------------------------------------
# 无头截图脚本 tools/shot.py 的输出，以及自动操作版测试页
# （含 base64 内嵌的整本书，单个文件就 4 MB）
epubreader/build/


# ------------------------------------------------------------
#  四、原始素材：解压出来的书
# ------------------------------------------------------------
# 书/ 是 书.zip 解开的结果，428 个文件、7.6 MB，完全可以从 zip 重新解出来。
书/

# ⚠ 书.zip 本身也绝不能入库。
# 它是有版权的电子书原文，一旦进了 git 历史，就算后来删掉，
# blob 依然会被推到远端 —— 等于把全书公开发布。要发布仓库就必须重建历史。
书.zip

# 个人环境备忘（含本机路径），不属于项目，不对外发布
安卓开发环境参考.md

# 重建历史时留下的 git 备份（确认无误后可自行删除）
.git-backup-*/


# ------------------------------------------------------------
#  五、AI 助手的会话记忆（不是项目源码）
# ------------------------------------------------------------
# .workbuddy/memory/ 下是按天追加的工作日志，每次会话都会写，
# 提交进去只会把历史淹成流水账。
# 注意：这个目录里有项目的技术决策记录，如果你想让它进版本管理，
#       把下面这行删掉或改成注释即可。
.workbuddy/


# ------------------------------------------------------------
#  六、工具 / 系统 / 编辑器产生的垃圾
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.log
*.tmp

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# macOS
.DS_Store
._*

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 签名文件（放别处备份，别进仓库）
*.jks
*.keystore
